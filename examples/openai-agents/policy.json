{
  "policy_id": "pol_comms_v1",
  "client_id": "demo_customer",
  "rules": [
    {
      "id": "rule_broadcast_review",
      "target_action": "send_customer_broadcast",
      "condition": "resource.attributes.recipient_count > 1000 && resource.attributes.external == true",
      "effect": "RE_ROUTE",
      "fallback_effect": "ALLOW",
      "remediation_message": "Bulk external communication requires human review before sending."
    }
  ]
}
